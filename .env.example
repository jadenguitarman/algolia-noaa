# Public browser values only. Never put admin keys or NOAA tokens here.
VITE_ALGOLIA_APP_ID=
VITE_ALGOLIA_SEARCH_API_KEY=
VITE_ALGOLIA_INDEX_NAME=noaa_weather_demo
VITE_ALGOLIA_AGENT_ID=

# Server/local-only values used by scripts. Keep these in .env.local.
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_AGENT_USER_AUTH_KEY=
# Optional when the key ID is not resolved from the local Admin key.
ALGOLIA_AGENT_USER_AUTH_KEY_ID=
ALGOLIA_AGENT_USER_ID=noaa-demo-user
# NOAA CDO v2 requires a token and a descriptive User-Agent.
NOAA_USER_AGENT="algolia-noaa-weather-demo/1.0 (https://github.com/jadenguitarman/algolia-noaa)"
NOAA_CDO_TOKEN=
ALGOLIA_APP_ID=
