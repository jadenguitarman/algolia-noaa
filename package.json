{
  "name": "algolia-noaa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "download": "node --import tsx/esm scripts/download-noaa.ts",
    "normalize": "node --import tsx/esm scripts/normalize-noaa.ts",
    "fixture": "node --import tsx/esm scripts/build-fixture.ts",
    "seed": "node --import tsx/esm scripts/seed-algolia.ts",
    "evaluate": "node --import tsx/esm scripts/evaluate-agent.ts",
    "coverage": "node --import tsx/esm scripts/coverage.ts"
  },
  "dependencies": {
    "@algolia/client-search": "latest",
    "algoliasearch": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-instantsearch": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^4.3.4",
    "instantsearch.css": "^8.5.1",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "^6.4.1"
  }
}
